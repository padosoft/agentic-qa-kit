{
  "name": "@padosoft/agentic-qa-kit-docs",
  "version": "1.0.0",
  "description": "Static docmd documentation for agentic-qa-kit.",
  "main": "index.js",
  "scripts": {
    "dev": "node node_modules/@docmd/core/dist/bin/docmd.js dev --config docmd.config.json",
    "build": "node node_modules/@docmd/core/dist/bin/docmd.js build --config docmd.config.json && node node_modules/docmd-search/dist/bin/docmd-search.js ..",
    "check": "node node_modules/@docmd/core/dist/bin/docmd.js validate --config docmd.config.json && node ../scripts/check-no-raw-html.mjs"
  },
  "keywords": [],
  "author": "Padosoft <info@padosoft.com>",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@docmd/core": "^0.8.6",
    "@huggingface/transformers": "^4.0.0",
    "docmd-search": "^0.1.0-alpha.0",
    "onnxruntime-node": "^1.24.3"
  }
}
