        "**/*.md"
      ],
      "exclude": [
        "**/.git/**",
        "**/node_modules/**"
      ],
      "showFilters": true,
      "showConfidence": false
    },
    "git": {
      "repo": "https://github.com/padosoft/agentic-qa-kit",
      "branch": "main",
      "editLink": true,
      "lastUpdated": true,
      "commitHistory": true,
      "maxCommits": 5,
      "dateFormat": "relative"
    },
    "seo": {
      "titleTemplate": "%s | agentic-qa-kit",
