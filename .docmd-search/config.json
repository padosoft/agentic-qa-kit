{
  "model": "Xenova/all-MiniLM-L6-v2",
  "chunkSize": 512,
  "chunkOverlap": 64,
  "overlap": 64,
  "incremental": true,
  "topK": 10,
  "include": [
    "docs-site/docs/**/*.md",
    "_site/**/*.html",
    "_site/llms.txt"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.docmd-search/**"
  ],
  "outDir": "_site/.docmd-search"
}
